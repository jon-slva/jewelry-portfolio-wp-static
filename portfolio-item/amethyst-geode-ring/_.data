},{"_28":76,"_44":154},{"_28":144,"_44":153},"img/amethyst-geode-ring/ametyst-1-1068.webp","img/amethyst-geode-ring/ametyst-1-800.webp","img/amethyst-geode-ring/ametyst-1-400.webp","title","Amethyst Geode Ring","amethyst-geode-ring","subtitle","date","2023-06-17","draft","featured","categories",[27],"tags",[24,22,19],"description","This was my first ring I ever designed for my brand back in 2012. I got it to work on the first iteration, and refined it to what it is today by the second version. It's set with a cross section of Uruguayan Amethyst. Carefully hand cut. I had the vision for this, and knew right away that Amethyst in Uruguay would be perfect, because of it's small crystal size and deep color relative to other amethyst. I wore one myself for many years.","software",[195,196],"client","media/amethyst-geode-ring/x-axis-geoder-ring-thumb.jpg","layout",{"_55":192,"_193":194},[177,178,179,180,181,182,183],{"_55":56,"_184":191,"_59":141,"_61":142},{"_55":56,"_184":190,"_59":131,"_61":62},{"_55":56,"_184":189,"_59":119,"_61":62},{"_55":56,"_184":188,"_59":108,"_61":62},{"_55":56,"_184":187,"_59":96,"_61":62},{"_55":56,"_184":186,"_59":80,"_61":62},{"_55":56,"_184":185,"_59":60,"_61":62},"file","media/amethyst-geode-ring/img_1616.jpg","media/amethyst-geode-ring/img_1618.jpg","media/amethyst-geode-ring/amethyst-matrix-ring-x-axis-1-e1520821262430.jpg","media/amethyst-geode-ring/amethyst-matrix-ring-x-axis-2-e1520821344894.jpg","media/amethyst-geode-ring/amethyst-matrix-ring-x-axis-18.jpg","media/amethyst-geode-ring/amethyst-matrix-ring-x-axis-14.jpg","media/amethyst-geode-ring/ametyst-1.jpg","masonry","columns",3,"Rhinoceros 3D","Matrix"]
