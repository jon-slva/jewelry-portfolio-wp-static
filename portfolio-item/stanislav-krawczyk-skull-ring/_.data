ebp","2-image","Stanislav Krawczyk Skull Ring – view 3",{"_32":66,"_34":67,"_36":68,"_38":39,"_40":89,"_42":90,"_44":91},[92,93],"img/stanislav-krawczyk-skull-ring/pain-ring-8.jpg","31f7144eacaa",{"_32":50,"_48":95},{"_32":66,"_48":94},"img/stanislav-krawczyk-skull-ring/pain-ring-8-680.webp","img/stanislav-krawczyk-skull-ring/pain-ring-8-400.webp","1-image","Stanislav Krawczyk Skull Ring – view 2",{"_32":66,"_34":67,"_36":68,"_38":39,"_40":99,"_42":100,"_44":101},[102,103],"img/stanislav-krawczyk-skull-ring/pain-ring-13.jpg","3a98c6951ecd",{"_32":50,"_48":105},{"_32":66,"_48":104},"img/stanislav-krawczyk-skull-ring/pain-ring-13-680.webp","img/stanislav-krawczyk-skull-ring/pain-ring-13-400.webp","0-image","Stanislav Krawczyk Skull Ring – view 1","large",{"_32":66,"_34":67,"_36":37,"_38":39,"_40":110,"_42":111,"_44":112},[113,114],"img/stanislav-krawczyk-skull-ring/monster-web.jpg","f676770de6f5",{"_32":50,"_48":116},{"_32":66,"_48":115},"img/stanislav-krawczyk-skull-ring/monster-web-680.webp","img/stanislav-krawczyk-skull-ring/monster-web-400.webp","title","Stanislav Krawczyk Skull Ring","stanislav-krawczyk-skull-ring","subtitle","Intenebris X Stanislav Krawczyk","date","2023-06-18","draft","featured","categories",[30,28],"tags",[24,22,19],"description","This is another fun and highly experimental artist collaborations. Stan is a well known Ukrainian dark artist with cerebral palsy. His condition left him entirely paralyzed on one side of his body since an early age, as well as mostly blind. Despite that, he uses what mobility and vision he has to create deeply expressive scratchy pen drawings depicting what his life experience - each one with the same title - \"Pain\". The 3D model is not shown here, because honestly, it's ugly. This was purely experimental, and was always intended to be hand finished and seen exactly the way it looks in these photos.","software",[152],"client","Intenebris, Stanislav Krawczyk","media/stanislav-krawczyk-skull-ring/stan-darkart-ring-thumb.jpg","layout",{"_57":151},[140,141,142,143,144],{"_57":58,"_145":150,"_61":107,"_63":108},{"_57":58,"_145":149,"_61":97,"_63":64},{"_57":58,"_145":148,"_61":87,"_63":64},{"_57":58,"_145":147,"_61":77,"_63":64},{"_57":58,"_145":146,"_61":62,"_63":64},"file","media/stanislav-krawczyk-skull-ring/pain-ring-5.jpg","media/stanislav-krawczyk-skull-ring/pain-ring-4.jpg","media/stanislav-krawczyk-skull-ring/pain-ring-8.jpg","media/stanislav-krawczyk-skull-ring/pain-ring-13.jpg","media/stanislav-krawczyk-skull-ring/monster-web.jpg","stacked","Zbrush"]
